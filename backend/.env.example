# 이 파일은 git에 커밋됨 (실제 값 없이 "형식"만 공유하는 템플릿)
# 새 개발자는 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.

DATABASE_URL=postgresql://유저이름:비밀번호@localhost:5432/orbit

# 구글 OAuth (Google Cloud Console 에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 JWT 서명 키 — 아래 명령으로 생성해 채운다:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Cloudinary (학습 기록 이미지 업로드) — 대시보드 > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 배포 설정 (없으면 아래 주석의 로컬 기본값으로 동작) ──

# CORS 허용 오리진 (프론트 주소). 쉼표로 여러 개.
# 참고: 프론트가 /api 프록시(next.config.ts rewrites)로 백엔드를 부르므로, 브라우저는
#   백엔드에 직접 요청하지 않는다 → 실사용상 CORS 는 거의 무의미. 비워둬도 로그인 동작함.
# 로컬 기본값: http://localhost:3000
CORS_ORIGINS=

# 구글 OAuth 콜백 URL — 구글 콘솔 "승인된 리디렉션 URI" 에도 같은 값을 등록해야 함.
# 콜백은 프론트의 /api 프록시를 거친다(주소가 프론트 오리진 + /api/... 임에 유의).
# 로컬 기본값: http://localhost:3000/api/auth/google/callback
# 배포 예: GOOGLE_REDIRECT_URI=https://orbit-xxx.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# 로그인 완료 후 돌려보낼 프론트 주소.
# 로컬 기본값: http://localhost:3000
# 배포 예: FRONTEND_URL=https://orbit-xxx.vercel.app
FRONTEND_URL=

# 세션 쿠키 속성.
# 프론트 /api 프록시 덕분에 브라우저는 프론트와 same-origin → SameSite=None 불필요.
# 로컬(http): 비워두면 lax + secure=false 로 동작.
# 배포(https): 아래처럼. (SameSite=Lax 는 모바일 크로스사이트 쿠키 차단의 영향을 받지 않음)
#   COOKIE_SAMESITE=lax
#   COOKIE_SECURE=true
COOKIE_SAMESITE=
COOKIE_SECURE=
