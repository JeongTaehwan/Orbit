# 이 파일은 git에 커밋됨 (실제 값 없이 "형식"만 공유하는 템플릿)
# 새 개발자는 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.

DATABASE_URL=postgresql://유저이름:비밀번호@localhost:5432/orbit

# 구글 OAuth (Google Cloud Console 에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 JWT 서명 키 — 아래 명령으로 생성해 채운다:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Cloudinary (학습 기록 이미지 업로드) — 대시보드 > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 배포 설정 (없으면 아래 주석의 로컬 기본값으로 동작) ──

# CORS 허용 오리진 (프론트 주소). 쉼표로 여러 개.
# 로컬 기본값: http://localhost:3000
# 배포 예: CORS_ORIGINS=http://localhost:3000,https://orbit-xxx.vercel.app
CORS_ORIGINS=

# 구글 OAuth 콜백 URL — 구글 콘솔 "승인된 리디렉션 URI" 에도 같은 값을 등록해야 함.
# 로컬 기본값: http://localhost:8000/auth/google/callback
# 배포 예: GOOGLE_REDIRECT_URI=https://orbit-api.up.railway.app/auth/google/callback
GOOGLE_REDIRECT_URI=

# 로그인 완료 후 돌려보낼 프론트 주소.
# 로컬 기본값: http://localhost:3000
# 배포 예: FRONTEND_URL=https://orbit-xxx.vercel.app
FRONTEND_URL=

# 세션 쿠키 속성 (크로스 도메인 로그인용).
# 로컬(http, 같은 localhost): 비워두면 lax + secure=false 로 동작.
# 배포(프론트·백엔드 도메인 다름, https): 아래처럼 둘 다 켜야 쿠키가 오간다.
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
COOKIE_SAMESITE=
COOKIE_SECURE=
